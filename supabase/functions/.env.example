# =============================================================================
# Supabase Edge Function secrets (server-side only - NEVER shipped to the app).
# Set these with:  supabase secrets set KEY=value
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the Edge runtime and do NOT need to be set here in prod.
# =============================================================================

# ---- AI provider ------------------------------------------------------------
# AI_PROVIDER: "openai" | "anthropic" | "placeholder"
# Leave as "placeholder" (or unset AI_API_KEY) to run WITHOUT any AI cost - the
# functions return warm, hand-authored fallback content so the app works fully.
AI_PROVIDER=placeholder
AI_API_KEY=
# Optional overrides:
# AI_MODEL=gpt-5-mini             # or e.g. claude-haiku-4-5-20251001
# AI_BASE_URL=https://api.openai.com/v1

# ---- RevenueCat webhook -----------------------------------------------------
# The exact string you enter as the webhook "Authorization" header in RevenueCat.
REVENUECAT_WEBHOOK_SECRET=

# ---- Free-plan enforcement --------------------------------------------------
# false (default) = unlimited (great for the MVP demo before RevenueCat is live)
# true            = enforce free monthly limits (3 hugs, 1 repair) server-side
ENFORCE_USAGE_LIMITS=false

# ---- Injected automatically in production (needed only for LOCAL functions) --
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
