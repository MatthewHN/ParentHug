# ParentHug landing page environment (apps/web)
# Copy to .env.local and fill in. All NEXT_PUBLIC_* values are exposed to the browser.

# Store links - leave as "#" until the apps are live, then paste real URLs.
NEXT_PUBLIC_APP_STORE_URL=#
NEXT_PUBLIC_GOOGLE_PLAY_URL=#

# Canonical site URL (used for metadata / Open Graph).
NEXT_PUBLIC_SITE_URL=https://parenthug.app

# Support email shown in legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=contacto@quimify.com
