# ParentHug mobile environment (apps/mobile)
# Copy to `.env` and fill in. Run with:
#   flutter run --dart-define-from-file=.env
# In Android Studio: Run → Edit Configurations → add
#   "Additional run args:  --dart-define-from-file=.env"
#
# Nothing secret belongs here. AI keys live ONLY in Supabase (server-side).

# ---- Supabase ----
# From Supabase → Project Settings → API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ---- RevenueCat (public SDK keys) ----
# From RevenueCat → Project → API keys. Safe to ship (public keys).
# Leave blank to run in demo-unlock mode (all premium features visible).
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=
